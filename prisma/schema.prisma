generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



/// Roles are mutually exclusive: a `User` holds exactly one.
enum Role {
  HACKER
  JUDGE
  MENTOR
  VOLUNTEER
  ORGANIZER
  ADMIN
  UNDECLARED
}

enum UserStatus {
  CREATED
  APPLIED
  CONFIRMED
  DECLINED
  CHECKED_IN
}

enum DecisionStatus {
  PENDING
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum QuestionType {
  MULTIPLE_CHOICE
  DROPDOWN
  NUMBER
  CHECKBOX
  /// Several of `options` at once. The answer is a JSON array of the chosen options
  /// in `ApplicationResponse.value`; see `$lib/questions/multiSelect`.
  MULTI_SELECT
  SHORT_TEXT
  LONG_TEXT
  /// An uploaded file. The answer is the original filename, not a key — the key is
  /// derived from userId/questionId. Not writable through `application.save`, which
  /// takes a string; uploads go through their own endpoint.
  FILE
}

/// The `User` column a question's answer writes through to, on every autosave.
enum LinkedField {
  NAME
  UNIVERSITY
  YEAR
}

/// A bundled option list a question draws its choices from, instead of `options`.
///
/// Exists because the university vocabulary is 6,400 entries. Putting those in
/// `Question.options` would mean 650 KB in the row, 6,400 editable rows in the
/// options editor, and a data migration every time the dataset is refreshed. A
/// preset names the list and leaves it in the bundle, where it can be regenerated
/// by re-running a script.
enum OptionPreset {
  UNIVERSITIES_NA
}

enum ScheduleType {
  EVENT
  WORKSHOP
  MEAL
  CEREMONY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  uid             String              @id @default(cuid())
  name            String
  email           String              @unique
  university      String?
  year            String?
  application     ApplicationResponse[]
  scans           Scan[]
  teamId          String?
  team            Team?               @relation(fields: [teamId], references: [id])
  groupId         String?
  group           Group?              @relation(fields: [groupId], references: [id])
  pendingDecision DecisionStatus?
  activeDecision  DecisionStatus?
  role            Role                @default(UNDECLARED)
  status          UserStatus          @default(CREATED)
  createdAt       DateTime            @default(now())

  /// Presence lock: the admin currently reviewing this applicant.
  claimedBy       String?
  claimedAt       DateTime?
  claimer         User?               @relation("ApplicationClaims", fields: [claimedBy], references: [uid])
  claims          User[]              @relation("ApplicationClaims")
  score           Int?
  notes           String?
  scoredBy        String?
  scoredAt        DateTime?
  scorer          User?               @relation("ApplicationScores", fields: [scoredBy], references: [uid])
  scores          User[]              @relation("ApplicationScores")

  decidedBy       String?
  decidedAt       DateTime?
  decider         User?               @relation("ApplicationDecisions", fields: [decidedBy], references: [uid])
  decisions       User[]              @relation("ApplicationDecisions")

  invitations Invitation[]
  logs        Log[]

  @@index([claimedBy])
  @@index([decidedBy, decidedAt])
  @@index([score])
}

model ApplicationResponse {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model Settings {
  id                  String   @id @default(cuid())
  applicationOpen     DateTime
  applicationDeadline DateTime
  RSVPDeadline        DateTime?
  admissionsSend      DateTime?
  hackathonStartDate  DateTime
  scanActions         String[]

  submitTemplate      String
  submitSubject       String   @default("We received your application")
  acceptTemplate      String
  acceptSubject       String   @default("You've been accepted!")
  confirmTemplate     String
  confirmSubject      String   @default("Your RSVP is confirmed")
  declineTemplate     String
  declineSubject      String   @default("Your RSVP has been declined")
  rejectTemplate      String
  rejectSubject       String   @default("An update on your application")
  waitlistTemplate    String
  waitlistSubject     String   @default("You're on the waitlist")

  /// IANA identifier, e.g. "America/Chicago".
  timezone            String

  homeState           String?
}

model Blacklist {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?  @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Question {
  id          String              @id @default(cuid())
  title       String
  type        QuestionType
  order       Int                 @default(0)
  required    Boolean             @default(false)
  targetRole  Role[]
  placeholder String?
  options     String[]
  min         Float?
  max         Float?
  regex       String?
  linkedField LinkedField?

  optionPreset OptionPreset?

  /// Offer an "Other" box alongside the options, on MULTI_SELECT and MULTIPLE_CHOICE
  /// and DROPDOWN. The typed answer is stored in place of an option, so it needs no
  /// separate column — on a multi-select it is simply the one member of the set that
  /// isn't in `options`. A preset already takes write-ins without it; see
  /// `acceptsWriteIn`.
  allowOther  Boolean             @default(false)

  responses   ApplicationResponse[]
}

model Schedule {
  id          String       @id @default(cuid())
  name        String
  description String?
  start       DateTime
  end         DateTime
  location    String
  type        ScheduleType
}

model Scan {
  id        String   @id @default(cuid())
  action    String
  timestamp DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId, action, timestamp])
  @@index([timestamp])
}

model Log {
  id        String   @id @default(cuid())
  /// Stable dot-slug — `admissions.decision.set`. `LOG_ACTIONS` maps it to a label.
  action    String
  summary   String
  timestamp DateTime @default(now())

  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [uid], onDelete: SetNull)
  actorName  String?
  actorEmail String?
  targetId    String?
  targetLabel String?
  metadata Json?
  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([action, timestamp])
}

model EmailLog {
  id       String   @id @default(cuid())
  template String?
  subject  String
  body     String
  userIds  String[]
  sentAt   DateTime @default(now())
  // Written before the first message goes out, then filled in as the client drives
  // the send. A closed tab leaves a row saying exactly how far it got, and a rerun
  // skips `sent` rather than mailing anyone twice.
  sent     String[]
  failed   String[]
}

model Group {
  id      String @id @default(cuid())
  name    String
  members User[]
}

model Team {
  id          String       @id @default(cuid())
  teamName    String
  inviteCode  String       @unique @default(uuid())
  members     User[]
  invitations Invitation[]
}

model Invitation {
  id     String           @id @default(cuid())
  teamId String
  team   Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email  String
  userId String?
  user   User?            @relation(fields: [userId], references: [uid], onDelete: SetNull)
  status InvitationStatus @default(PENDING)
}