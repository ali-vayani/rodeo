generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



// Enums
// -----------------------------------------------------------------------------

/// Roles are mutually exclusive: a `User` holds exactly one. Staff (ADMIN,
/// ORGANIZER) and attendees (HACKER, JUDGE, MENTOR, VOLUNTEER) are disjoint
/// populations, and the two portals are partitioned along that line — see
/// `$lib/auth/permissions`, which is the single source of truth for the split.
enum Role {
  HACKER
  JUDGE
  MENTOR
  VOLUNTEER
  ORGANIZER
  ADMIN
  UNDECLARED
}

enum UserStatus {
  CREATED
  APPLIED
  CONFIRMED
  DECLINED
  CHECKED_IN
}

enum DecisionStatus {
  PENDING
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum QuestionType {
  MULTIPLE_CHOICE
  /// Always searchable. This was briefly two types — a plain one and a searchable one
  /// — which made every organizer choose between them on every question, for a
  /// difference that is really just "how long is the list". A type-ahead over six
  /// options costs nothing and a plain `<select>` over 6,400 is unusable, so the
  /// control adapts instead of the schema branching.
  DROPDOWN
  NUMBER
  CHECKBOX
  SHORT_TEXT
  LONG_TEXT
}

/// The `User` column a question's answer writes through to, on every autosave.
///
/// Was a bare `String?` carrying `"name" | "university" | "year"` in a comment. The
/// value is used as a computed property key into a Prisma `update`, so the comment
/// was the only thing standing between a typo and a question that silently writes
/// nowhere — `questions.change` accepted any string, and the allowlist was not
/// consulted until read time. An enum moves that check to the database and to Zod.
enum LinkedField {
  NAME
  UNIVERSITY
  YEAR
}

/// A bundled option list a question draws its choices from, instead of `options`.
///
/// Exists because the university vocabulary is 6,400 entries. Putting those in
/// `Question.options` would mean 650 KB in the row, 6,400 editable rows in the
/// options editor, and a data migration every time the dataset is refreshed. A
/// preset names the list and leaves it in the bundle, where it can be regenerated
/// by re-running a script.
enum OptionPreset {
  UNIVERSITIES_NA
}

enum ScheduleType {
  EVENT
  WORKSHOP
  MEAL
  CEREMONY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Models
// -----------------------------------------------------------------------------

model User {
  uid             String              @id @default(cuid())
  name            String
  email           String              @unique
  university      String?
  year            String?
  application     ApplicationResponse[]
  scans           Scan[]
  teamId          String?
  team            Team?               @relation(fields: [teamId], references: [id])
  groupId         String?
  group           Group?              @relation(fields: [groupId], references: [id])
  pendingDecision DecisionStatus?
  activeDecision  DecisionStatus?
  /// Exactly one. Singular and non-null on purpose: the array this replaced let an
  /// account be ADMIN and HACKER at once, which made "which portal is this person
  /// in" a question with no answer and forced every guard to invent a precedence
  /// rule of its own. A scalar makes the exclusivity unrepresentable-otherwise
  /// rather than merely enforced.
  role            Role                @default(UNDECLARED)
  status          UserStatus          @default(CREATED)
  createdAt       DateTime            @default(now())

  // Presence lock: which admin is currently reviewing this applicant
  claimedBy       String?
  claimedAt       DateTime?
  claimer         User?               @relation("ApplicationClaims", fields: [claimedBy], references: [uid])
  claims          User[]              @relation("ApplicationClaims")

  // Review score, 0–20, and the reviewer's notes.
  //
  // Scoring and deciding are two passes now, not one: reviewers score the whole
  // queue first, and only then is the ranked list worked top-down. A scalar
  // rather than a Review table because one score settles an applicant — the
  // presence lock already hands each application to exactly one reviewer, so a
  // second score would only ever be an edit of the first, not a second opinion
  // to average in. Making that a table would buy an aggregate nobody computes.
  //
  // `notes` is deliberately readable by every admin: they exist to be read
  // during the decision pass, which is a different sitting, usually by a
  // different person, from the one that wrote them.
  score           Int?
  notes           String?
  scoredBy        String?
  scoredAt        DateTime?
  scorer          User?               @relation("ApplicationScores", fields: [scoredBy], references: [uid])
  scores          User[]              @relation("ApplicationScores")

  // Decision attribution: which admin last set this applicant's decision.
  // Written in the same UPDATE as the decision itself, never as a follow-up
  // statement — that is what makes per-admin stats impossible to drift. A
  // counter table would need a decrement here ("whose accepted count goes
  // down?"), a question this column answers for free: reattributing the row
  // moves it between GROUP BY buckets with no arithmetic to get wrong.
  // Null means nobody is accountable — pre-migration history, or the
  // blacklist auto-reject in `application.submit`, where no admin acted.
  decidedBy       String?
  decidedAt       DateTime?
  decider         User?               @relation("ApplicationDecisions", fields: [decidedBy], references: [uid])
  decisions       User[]              @relation("ApplicationDecisions")

  invitations Invitation[]
  logs        Log[]

  // Supports `claim`'s drop-my-other-claims lookup and the `presence` scan.
  // claimedAt is deliberately NOT indexed — heartbeat rewrites it every 30s per
  // active reviewer, which would be pure index churn on a hot write path.
  @@index([claimedBy])
  // Serves `stats.byAdmin`'s groupBy. Unlike claimedAt, decidedAt IS worth
  // covering: it is written once per decision, not every 30s, and the stats
  // page filters on it by time window.
  @@index([decidedBy, decidedAt])
  // The ranked list's ORDER BY, and the scoring queue's `score IS NULL` filter.
  @@index([score])
}

model ApplicationResponse {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String // json?
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

model Settings {
  id                  String   @id @default(cuid())
  applicationOpen     DateTime
  applicationDeadline DateTime
  RSVPDeadline        DateTime
  admissionsSend      DateTime?
  hackathonStartDate  DateTime
  scanActions         String[]

  // Lifecycle email templates, edited at /admin/email-templates. Every subject
  // carries a @default so adding one to a populated table backfills in a single
  // statement, and so updateTemplates can create a row without naming all 19 fields.
  submitTemplate      String
  submitSubject       String   @default("We received your application")
  acceptTemplate      String
  acceptSubject       String   @default("You've been accepted!")
  confirmTemplate     String
  confirmSubject      String   @default("Your RSVP is confirmed")
  declineTemplate     String
  declineSubject      String   @default("Your RSVP has been declined")
  rejectTemplate      String
  rejectSubject       String   @default("An update on your application")
  waitlistTemplate    String
  waitlistSubject     String   @default("You're on the waitlist")

  timezone            String // IANA identifier, e.g. "America/Chicago"
}

/// An entry carries two independent signals, and they are deliberately not equal in weight:
///
///   - `email` is an identity. An exact match auto-rejects at `application.submit`.
///   - `firstName`/`lastName` are a heuristic. A match only flags the applicant for a
///     reviewer; it never decides anything on its own.
///
/// That asymmetry is what lets name matching be typo-tolerant (see `$lib/blacklist/match`)
/// without a misspelling ever costing someone their application.
model Blacklist {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  /// Optional so an organizer can blacklist a name they have no email for.
  /// Stored normalized (trimmed + lowercased) so the unique index is case-insensitive.
  /// Postgres permits many NULLs under a unique index, so name-only rows don't collide.
  email     String?  @unique
  reason    String?
  createdAt DateTime @default(now())

  /// Name matching loads every row and compares in application code, so the common
  /// case — listing the blacklist newest-first — is the only query worth indexing.
  @@index([createdAt])
}

model Question {
  id          String              @id @default(cuid())
  title       String
  type        QuestionType
  order       Int                 @default(0)
  required    Boolean             @default(false)
  targetRole  Role[]
  placeholder String?
  options     String[]
  min         Float?
  max         Float?
  regex       String?
  linkedField LinkedField?
  /// When set, the choices come from this bundled list and `options` is ignored.
  /// Answers are then no longer restricted to the list — see `assertAnswerValid`.
  optionPreset OptionPreset?
  responses   ApplicationResponse[]
}

model Schedule {
  id          String       @id @default(cuid())
  name        String
  description String?
  start       DateTime
  end         DateTime
  location    String
  type        ScheduleType
}

model Scan {
  id        String   @id @default(cuid())
  action    String
  timestamp DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  // Backs isDuplicateToday's (userId, action, since-midnight) lookup and getHistory's
  // per-user trail; the timestamp index backs getRecent's newest-first scan.
  @@index([userId, action, timestamp])
  @@index([timestamp])
}

/// The append-only audit trail: who did what, to whom, and with what detail.
///
/// Actor identity is stored twice on purpose. `actorId` is the live relation, so
/// the logs page can filter by admin and join to the current record. `actorName`
/// and `actorEmail` are snapshots taken at write time, because the FK nulls out
/// when an organizer is removed and an audit row reading "— released 240
/// decisions" is worth nothing. The snapshot is the record; the relation is the
/// convenience.
model Log {
  id        String   @id @default(cuid())
  /// Stable dot-slug — `admissions.decision.set`. Never rendered raw: it is what
  /// the logs page filters on and what `LOG_ACTIONS` maps to a human label.
  action    String
  /// The sentence a human reads: "Accepted Sarah Chen". Rendered *after* the
  /// actor's name, so it opens with the verb and never repeats the actor.
  summary   String
  timestamp DateTime @default(now())

  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [uid], onDelete: SetNull)
  actorName  String?
  actorEmail String?

  /// What was acted on. Deliberately not a relation — targets are users,
  /// questions, schedule events and blacklist entries alike, and an audit row has
  /// to outlive the row it describes.
  targetId    String?
  targetLabel String?

  /// Action-specific detail, e.g. `{"from":"PENDING","to":"ACCEPTED"}`.
  /// Write-once and display-only; nothing branches on its contents.
  metadata Json?

  /// Every read is "newest first, optionally narrowed by actor or action", so the
  /// composite indexes carry the filtered variants without a separate sort step.
  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([action, timestamp])
}

model EmailLog {
  id       String   @id @default(cuid())
  template String?
  subject  String
  body     String
  userIds  String[]
  sentAt   DateTime @default(now())
}

model Group {
  id      String @id @default(cuid())
  name    String
  members User[]
}

model Team {
  id          String       @id @default(cuid())
  teamName    String
  inviteCode  String       @unique @default(uuid())
  members     User[]
  invitations Invitation[]
}

model Invitation {
  id     String           @id @default(cuid())
  teamId String
  team   Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email  String
  userId String?
  user   User?            @relation(fields: [userId], references: [uid], onDelete: SetNull)
  status InvitationStatus @default(PENDING)
}