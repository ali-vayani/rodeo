# Rodeo environment variables.
#
#   cp .env.example .env
#
# Only DATABASE_URL is needed for local development: auth falls back to the
# yopmail bypass and email is printed to the console. Everything below the first
# section is required on the production deploy and validated at boot by
# src/lib/server/env.ts.

# ---------------------------------------------------------------------------
# Always required
# ---------------------------------------------------------------------------

# Local Postgres (see docker-compose.yml). For Supabase, use the connection string from
# Project Settings → Database (use the pooler URL for serverless if applicable).
DATABASE_URL="postgresql://username:password@localhost:5432/rodeo-development"

# ---------------------------------------------------------------------------
# Auth — required in production, unused locally
# ---------------------------------------------------------------------------
#
# Google is the only production sign-in path; the first login creates the User
# row. Enable the Google provider in the Supabase dashboard and register
# https://<your-domain>/auth/callback as an authorised redirect URL.
#
# The anon key is a public credential — it is served to the browser by design.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Email — one transport required in production
# ---------------------------------------------------------------------------
#
# Set RESEND_API_KEY, or all three of EMAIL_HOST / EMAIL_USER / EMAIL_PASS for
# SMTP. Resend wins if both are present. Preview deploys only ever mail
# @yopmail.com addresses, whichever transport is configured.

RESEND_API_KEY=

EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# From: address on everything the app sends.
EMAIL_FROM=hello@freetailhackers.com

# ---------------------------------------------------------------------------
# Set automatically by Vercel — leave unset locally
# ---------------------------------------------------------------------------
#
# VERCEL_ENV = production | preview | development. It, not NODE_ENV, decides
# whether real auth and real email are in play.
